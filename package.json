{
  "name": "vision-toastmasters",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "python3 scripts/make-icons.py",
    "dev:local": "VITE_EMULATORS=1 vite",
    "emulators": "npx firebase-tools emulators:start --only auth,firestore --project demo-vtm",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-vtm \"node tests/rules.test.mjs\"",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
